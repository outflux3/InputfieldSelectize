<?php namespace ProcessWire;

/**
 * InputfieldSelectizeAjax module for ProcessWire
 *
 */

if(!class_exists('\ProcessWire\InputfieldPageAutocomplete')) {

    class InputfieldSelectizeAjax extends Inputfield {

        public static function getModuleInfo() {
            return array(
                'title' => 'Selectize with Ajax',
                'author' => 'Macrura',
                'version' => 123,
                'summary' => 'Selectize input, using ajax to populate options',
                'href' => '',
                'icon' => 'tags',
                'singular' => true,
                'autoload' => 'template=admin',
                'requires' => 'InputfieldPageAutocomplete',
            );
        }

        public function init() {
            parent::init();
            $this->warning($this->_('InputfieldPageAutocomplete is not installed — InputfieldSelectizeAjax is disabled.'));
        }

        public function renderReady(?Inputfield $parent = null, $renderValueMode = false) {
            return false;
        }

        public function ___render() {
            return '';
        }
    }

} else {

    class InputfieldSelectizeAjax extends InputfieldPageAutocomplete {

    public static function getModuleInfo() {
        return array(
            'title' => 'Selectize with Ajax',
            'author' => 'Macrura',
            'version' => 123,
            'summary' => 'Selectize input, using ajax to populate options',
            'href' => '',
            'icon' => 'tags',
            'singular' => false,
            'autoload' => 'template=admin',

        );
    }

    protected $selectizeOptions = array();
    protected $jsConfig = array();

    /**
     * Has the "data array must return an array" error been shown for this instance?
     *
     * @var bool
     */
    protected $itemDataError = false;

    public function setSelectizeOption($key, $value) {
        $this->selectizeOptions[$key] = $value;
    }

    /**
     * Encode data for a single-quoted HTML attribute (data-data='…').
     * Plain json_encode() leaves ' as is, which ends the attribute early.
     *
     * @param mixed $data
     * @return string
     */
    protected function jsonAttr($data) {
        return json_encode($data, JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_HEX_TAG);
    }

    /**
     * The ajax search URL (ProcessPageSearch).
     *
     * Without format_name: with a label format, ProcessPageSearch returns only the formatted
     * label, leaving out title and the display fields the option templates need.
     * (The field name still reaches addData(): core stores it with the search selector.)
     *
     * @return string
     */
    protected function ___getAjaxUrl() {
        $url = (string) parent::___getAjaxUrl();
        $url = preg_replace('/([?&])format_name=[^&]*(&|$)/', '$1', $url);
        return rtrim($url, '&?');
    }

    /**
     * The Page field an ajax search request is for, from the data core stored with its selector.
     *
     * Needs ProcessWire 3.0.238+ (getForSelector() with data); older versions return null.
     *
     * @param HookEvent $event ProcessPageSearch::executeFor
     * @return Field|null
     */
    protected function ajaxField(HookEvent $event) {
        $process = $event->object;
        $selectorName = $this->wire('input')->get->fieldName('for_selector_name');
        if(!$selectorName || !method_exists($process, 'getForSelector')) return null;
        $data = $process->getForSelector($selectorName, true);
        $name = is_array($data) && !empty($data['field']) ? $this->wire('sanitizer')->fieldName($data['field']) : '';
        if(!$name) return null;
        $field = $this->wire('fields')->get($name);
        if(!$field || $field->get('inputfield') !== $this->className()) return null;
        return $field;
    }

    /**
     * Field names from a settings string ("a b", "a,b" or "a|b"), keeping one "field.subfield" level.
     *
     * @param string $str
     * @return array
     */
    protected function fieldNames($str) {
        $sanitizer = $this->wire('sanitizer');
        $names = array();
        foreach(preg_split('/[\s,|]+/', (string) $str) as $name) {
            $subname = '';
            if(strpos($name, '.')) list($name, $subname) = explode('.', $name, 2);
            $name = $sanitizer->fieldName($name);
            if(!$name) continue;
            if($subname) {
                $subname = $sanitizer->fieldName($subname);
                if(!$subname) continue;
                $name .= ".$subname";
            }
            $names[$name] = $name;
        }
        return array_values($names);
    }

    /**
     * A field value as JSON-ready data, in the same shape ProcessPageSearch gives it in ajax results
     * (a Page becomes {id, parent_id, template, name, path, title}).
     *
     * @param mixed $value
     * @return mixed
     */
    protected function exportValue($value) {
        if($value instanceof Page) {
            return array(
                'id' => $value->id,
                'parent_id' => $value->parent_id,
                'template' => $value->template ? $value->template->name : '',
                'name' => $value->name,
                'path' => $value->path,
                'title' => (string) $value->get('title'),
            );
        }
        if($value instanceof WireData || $value instanceof WireArray) {
            $value = $value->getArray();
        } else if(is_object($value)) {
            return method_exists($value, '__toString') ? (string) $value : '';
        }
        if(is_array($value)) {
            foreach($value as $key => $v) $value[$key] = $this->exportValue($v);
        }
        return $value === null ? '' : $value;
    }

    /**
     * The text label for a page: label format, else label field, else title or name.
     *
     * @param Page $page
     * @param WireData $settings This Inputfield, or the Field during an ajax search
     * @return string
     */
    protected function labelText(Page $page, WireData $settings) {
        $sanitizer = $this->wire('sanitizer');
        $format = (string) $settings->get('labelFieldFormat');
        $labelField = (string) $settings->get('labelFieldName');
        if(!$labelField || $labelField === '.') $labelField = 'title';
        $text = $format ? $page->getText($format, true, false) : (string) $page->get($labelField);
        if(!strlen($text)) $text = (string) $page->get('title|name');
        $text = strip_tags($text);
        if(strpos($text, '&') !== false) $text = $sanitizer->unentities($text);
        return $text;
    }

    /**
     * Evaluate the field's PHP data array for one page.
     *
     * Kept apart so the code only sees $page (and $this).
     *
     * @param string $code
     * @param Page $page
     * @return mixed The returned value, or null when the code throws
     */
    protected function evalItemData($code, Page $page) {
        try {
            return eval($code);
        } catch(\Throwable $e) {
            return null;
        }
    }

    /**
     * The data for one item/option.
     *
     * Display fields come first, then the PHP data array (which wins over them), then id, editUrl
     * and a title fallback. Selected items (render) and ajax matches (addData) both use this,
     * so templates get the same data either way.
     *
     * @param Page $page
     * @param WireData $settings This Inputfield, or the Field during an ajax search
     * @return array
     */
    protected function itemData(Page $page, WireData $settings) {

        $data = array();

        foreach($this->fieldNames($settings->get('displayFields')) as $name) {
            if(strpos($name, '.')) {
                // field.subfield: the subfield's value, under the field name
                list($name, $subname) = explode('.', $name, 2);
                $value = $page->get($name);
                $data[$name] = $this->exportValue(is_object($value) ? $value->get($subname) : '');
                continue;
            }
            $thumbUrl = $this->thumbUrl($name, $page);
            if($thumbUrl) {
                if(!isset($data['thumbUrl'])) $data['thumbUrl'] = $thumbUrl;
            } else {
                $data[$name] = $this->exportValue($page->get($name));
            }
        }

        $code = trim((string) $settings->get('itemDataArray'));
        if(strlen($code)) {
            $extraData = $this->evalItemData($code, $page);
            if(is_array($extraData)) {
                $data = array_merge($data, $extraData);
            } else if(!$this->itemDataError && !$this->wire('config')->ajax) {
                $this->itemDataError = true;
                $this->error($this->_('Only arrays should be returned by your code. Please check that you have input valid code.'));
            }
        }

        $data['id'] = $page->id;
        if(!isset($data['editUrl'])) $data['editUrl'] = $page->editUrl;
        if(!isset($data['title']) || (is_string($data['title']) && !strlen($data['title']))) {
            $data['title'] = $this->labelText($page, $settings);
        }

        return $data;
    }


    /**
     * Attributes for the selected <option> of a single-value field.
     *
     * Hook this and return whatever extended attributes you need.
     *
     * @param Page $page
     * @return string
     */
    public function ___extendAttributes($page) {
        return "data-data='" . $this->jsonAttr($this->itemData($page, $this)) . "'";
    }


    /**
     * Data for one selected item of a multi-value field.
     *
     * Hook this and return whatever data you need.
     *
     * @param Page $page
     * @return array
     */
    public function ___extendAttributesMulti($page) {
        return $this->itemData($page, $this);
    }


    public function init() {
        parent::init();

        $this->set('searchField', '');
        $this->set('renderOptionMarkup', '');
        $this->set('renderItemMarkup', '');
        $this->set('allowEmptyOption', 0);
        $this->set('placeholderMore', '');

        $this->wire('modules')->get('JqueryUI')->use('selectize');

    }

    public function ready() {
        $this->addHookAfter('ProcessPageSearch::executeFor', $this, 'addData');
    }


    /**
     * Called before render()
     *
     * @param Inputfield $parent
     * @param bool $renderValueMode
     * @return bool
     *
     */
    public function renderReady(?Inputfield $parent = null, $renderValueMode = false) {

        $maxSelected = (int) $this->maxSelectedItems;

        if($this->required) {
            $this->allowEmptyOption = 1;
        }

        if($maxSelected != 1) {
            $this->setSelectizeOption('plugins', ['remove_button','drag_drop']);
            $this->set('size', null);
        }

        $this->setSelectizeOption('valueField', 'id');
        $this->setSelectizeOption('labelField', 'title');
        $this->setSelectizeOption('create', false);

        $searchFields = $this->fieldNames($this->searchFields);
        if(count($searchFields)) {
            $this->setSelectizeOption('searchField', $searchFields);
        }

        if($this->renderItemMarkup) {
            $this->jsConfig['renderItemMarkup'] = $this->renderItemMarkup;
        }

        if($this->renderOptionMarkup) {
            $this->jsConfig['renderOptionMarkup'] = $this->renderOptionMarkup;
        }

        $maxItems = (int) $this->maxItems;
        if(!$maxItems && $maxSelected > 1) $maxItems = $maxSelected;
        if($maxItems) {
            $this->setSelectizeOption('maxItems', $maxItems);
        }

        if($this->allowEmptyOption) {
            $this->setSelectizeOption('allowEmptyOption', true);
        }

        $this->jsConfig['selectizeOptions'] = $this->selectizeOptions;
        $this->config->js($this . '_' . $this->id, $this->jsConfig);

        return parent::renderReady($parent, $renderValueMode);

    }


    /**
     * Render the autocompletion widget
     *
     */
    public function ___render() {
        /** @var Sanitizer $sanitizer */
        $sanitizer = $this->wire('sanitizer');

        $this->useList = false;
        $max = (int) $this->maxSelectedItems;
        $multiple = $max != 1;

        $items = $this->wire('pages')->getById($this->value);
        $value = array();
        foreach($items as $item) {
            if($item && $item->id) $value[] = $item->id;
        }
        $value = implode(',', $value);

        // search fields as CSV for the ProcessPageSearch query, with "-" for subfields as core does
        $searchField = str_replace('.', '-', implode(',', $this->fieldNames($this->searchFields)));
        if(!$searchField) $searchField = 'title';

        // display fields for ProcessPageSearch: it can't return subfields, so ask for the field
        // itself; title is always included for the default label
        $displayField = array('title' => 'title');
        foreach($this->fieldNames($this->displayFields) as $name) {
            if(strpos($name, '.')) list($name, ) = explode('.', $name, 2);
            $displayField[$name] = $name;
        }
        $displayField = implode(',', $displayField);

        $labelField = $this->labelFieldFormat ? "autocomplete_$this->name" : $this->labelFieldName;

        $attrs = array(
            'placeholder' => $this->placeholder ?: $this->_('Type something'),
            'data-max' => $max,
            'data-url' => $this->getAjaxUrl(),
            'data-label' => $labelField,
            'data-search' => $searchField,
            'data-operator' => $this->operator,
            'data-fields' => $displayField,
        );
        if($multiple && strlen(trim((string) $this->placeholderMore))) {
            $attrs['data-placeholder-more'] = trim((string) $this->placeholderMore);
        }

        $attrStr = '';
        foreach($attrs as $name => $attrValue) {
            $attrStr .= " $name='" . $sanitizer->entities((string) $attrValue) . "'";
        }

        $id = $this->id;
        $name = $this->name;

        if($multiple) {
            $data = array();
            foreach($items as $item) {
                if($item && $item->id) $data[] = $this->extendAttributesMulti($item);
            }
            $input = "<input type='text' name='{$name}[]' id='$id' class='InputfieldSelectizeAjax' " .
                "value='$value' multiple{$attrStr} data-data='" . $this->jsonAttr($data) . "' />";

        } else {
            $option = '';
            $item = $items->first();
            if($item && $item->id) {
                $textValue = $sanitizer->entities($this->labelText($item, $this));
                $option = "<option selected value='$item->id' " . $this->extendAttributes($item) . ">$textValue</option>";
            }
            $input = "<select name='{$name}[]' id='$id' class='InputfieldSelectizeAjax'{$attrStr}>$option</select>";
        }

        return "\n<p><!-- Selectize Ajax -->\n\t$input\n</p>";
    }


    /**
     * Add the field's item data (display fields, thumbnail, PHP data array) to each ajax match,
     * so options get the same data as selected items. Runs on the module's autoload instance,
     * which has no field settings, so they come from the Page field the search is for.
     *
     * @param HookEvent $event ProcessPageSearch::executeFor
     */
    public function addData($event) {

        if(!$this->config->ajax) return;
        $field = $this->ajaxField($event);
        if(!$field) return;

        $responseArray = json_decode($event->return, true);
        if(!is_array($responseArray) || empty($responseArray['matches'])) return;

        foreach($responseArray['matches'] as $i => $match) {
            $page = $this->wire('pages')->get((int) $match['id']);
            if(!$page->id) continue;
            $responseArray['matches'][$i] = array_merge($match, $this->itemData($page, $field));
        }

        $event->return = json_encode($responseArray);

    }


    /**
     * URL of a 100x100 thumbnail when $field is an image field with an image, else ''.
     *
     * @param string $field
     * @param Page $page
     * @return string
     */
    protected function thumbUrl($field, Page $page) {
        $v = $page->get($field);
        if($v instanceof Pageimages) $v = $v->first();
        if(!$v instanceof Pageimage) return '';
        return (string) $v->size(100, 100)->url;
    }


    /**
     * Install the autocomplete module
     *
     * Make sure we're in InputfieldPage's list of valid page selection widgets
     *
     */
    public function ___install() {
        $data = $this->wire('modules')->getModuleConfigData('InputfieldPage');
        $data['inputfieldClasses'][] = $this->className();
        $this->wire('modules')->saveModuleConfigData('InputfieldPage', $data);
    }

    /**
     * Uninstall the autocomplete module
     *
     * Remove from InputfieldPage's list of page selection widgets
     *
     */
    public function ___uninstall() {
        $data = $this->wire('modules')->getModuleConfigData('InputfieldPage');
        foreach($data['inputfieldClasses'] as $key => $value) {
            if($value == $this->className()) unset($data['inputfieldClasses'][$key]);
        }
        $this->wire('modules')->saveModuleConfigData('InputfieldPage', $data);
    }



    /**
     * Provide configuration options for modifying the behavior when paired with InputfieldPage
     *
     */
    public function ___getConfigInputfields() {
        $inputfields = parent::___getConfigInputfields();
        $aceInstalled = $this->modules->get('InputfieldAceExtended') ? true : false;

        // Array of data to get about any item for use by the item/option markup
        if($aceInstalled) {
            $f = $this->modules->get('InputfieldAceExtended');
            $f->mode = "php";
            $f->theme = "monokai";
        } else {
            $f = $this->modules->get('InputfieldTextarea');
        }
        $f->attr('name', 'itemDataArray');
        $f->attr('value', $this->itemDataArray);
        $f->label = $this->_('Array of data to use for items/options');
        $f->description = $this->_('Your PHP code will be evaluated and MUST return an associative PHP array of the data to be used for each option.');
        $f->notes = $this->_('This eval has access to the $page variable. Its keys are added to (and override) the display fields below, for selected items and for search results.');
        $inputfields->add($f);

        // Optional, instead of above, enter the names of fields of whose values to add to the ajax object
        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'displayFields');
        $f->label = $this->_('List of fields whose data you need access to for the item and/or option markup.');
        $f->notes = $this->_('Separate with a space. A Page field gives an object (item.field.title, item.field.path …); field.subfield gives just that value (item.field). An image field gives item.thumbUrl (100x100). Every item also has id, title and editUrl.');
        //$f->collapsed = Inputfield::collapsedNo;
        $f->attr('value', $this->displayFields);
        $inputfields->add($f);

        // javascript function for markup that is used to create the item (what is visible once selected)
        if($aceInstalled) {
            $f = $this->modules->get('InputfieldAceExtended');
            $f->mode = "javascript";
            $f->theme = "monokai";
        } else {
            $f = $this->modules->get('InputfieldTextarea');
        }
        $f->attr('name', 'renderItemMarkup');
        $f->attr('value', $this->renderItemMarkup);
        $f->label = $this->_('Render item markup');
        $f->description = $this->_('This must be a valid javascript string which is passed to the render function');
        $f->notes = "for each field in your array, use escape(item.fieldName) ";
        $inputfields->add($f);

        // javascript function for markup that is used to create the option (visible in list)
        if($aceInstalled) {
            $f = $this->modules->get('InputfieldAceExtended');
            $f->mode = "javascript";
            $f->theme = "monokai";
        } else {
            $f = $this->modules->get('InputfieldTextarea');
        }
        $f->attr('name', 'renderOptionMarkup');
        $f->attr('value', $this->renderOptionMarkup);
        $f->label = $this->_('Render option markup');
        $f->description = $this->_('This must be a valid javascript string which is passed to the render function');
        $f->notes = "for each field in your array, use escape(item.fieldName)";
        $inputfields->add($f);

        // Placeholder for the input field.
        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'placeholder');
        $f->label = $this->_('Empty field placeholder');
        $f->collapsed = Inputfield::collapsedNo;
        $f->attr('value', $this->placeholder);
        $inputfields->add($f);

        // Placeholder once items are selected (multi-value fields)
        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'placeholderMore');
        $f->label = $this->_('Placeholder when items are selected');
        $f->description = $this->_('Multi-value fields only. Selectize removes the placeholder once an item is selected, so editors may not see that they can type to add more. Enter text to keep one, e.g. "Type here to add another…".');
        $f->notes = $this->_('Leave blank for the Selectize default (no placeholder once an item is selected).');
        $f->collapsed = Inputfield::collapsedNo;
        $f->attr('value', $this->placeholderMore);
        $inputfields->add($f);

        return $inputfields;
    }

    } // end real class

} // end if class_exists
